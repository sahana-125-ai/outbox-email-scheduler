# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Used to encrypt SMTP passwords at rest. Falls back to JWT_SECRET when empty.
ENCRYPTION_KEY=
# Comma-separated list when the app is served from more than one origin.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_scheduler
REDIS_URL=redis://localhost:6379

# Elasticsearch is optional. When unavailable the API transparently falls back
# to PostgreSQL full-text-ish search, so the product still works.
SEARCH_ENABLED=true
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Demo login lets reviewers try the product without provisioning Google OAuth.
# Defaults to true outside production. NEVER enable this in production.
DEMO_MODE=true
DEMO_USER_EMAIL=demo@outbox.dev
DEMO_USER_NAME=Oliver Brown

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---------------------------------------------------------------------------
# Slack (optional)
# ---------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
# Optional shortcut: paste an incoming webhook to connect Slack without OAuth.
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Worker / scheduling
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Maximum number of recipients accepted in a single campaign.
MAX_RECIPIENTS_PER_CAMPAIGN=5000

# ---------------------------------------------------------------------------
# SMTP fallback (used only when a sender has no usable SMTP configuration)
# ---------------------------------------------------------------------------
# "smtp" tries SMTP_HOST, "console" logs messages (zero external dependencies).
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=Outbox Scheduler <no-reply@outbox.dev>

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# Kept for future use; the demo data is seeded explicitly with `npm run db:seed`.
SEED_ON_START=false
