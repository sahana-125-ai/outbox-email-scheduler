generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleId  String?  @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders         Sender[]
  campaigns       Campaign[]
  slackConnection SlackConnection?
}

enum SenderProvider {
  SMTP
  ETHEREAL
  CONSOLE
}

model Sender {
  id             String         @id @default(cuid())
  userId         String
  email          String
  displayName    String
  provider       SenderProvider @default(SMTP)
  smtpHost       String
  smtpPort       Int            @default(587)
  smtpSecure     Boolean        @default(false)
  smtpUser       String
  /// AES-256-GCM ciphertext. Never returned by the API.
  smtpPass       String
  hourlyLimit    Int            @default(200)
  isActive       Boolean        @default(true)
  lastVerifiedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([userId, email])
  @@index([userId])
}

enum CampaignStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

model Campaign {
  id              String         @id @default(cuid())
  userId          String
  senderId        String
  name            String?
  subject         String
  /// Sanitised HTML body. A plain-text alternative is generated by the worker.
  body            String
  status          CampaignStatus @default(SCHEDULED)
  startTime       DateTime
  delaySeconds    Int            @default(0)
  hourlyLimit     Int
  totalRecipients Int
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender     @relation(fields: [senderId], references: [id])
  jobs   EmailJob[]

  @@index([userId, createdAt])
  @@index([status])
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED
  CANCELLED
}

model EmailJob {
  id                String      @id @default(cuid())
  campaignId        String
  recipientEmail    String
  recipientName     String?
  status            EmailStatus @default(SCHEDULED)
  scheduledFor      DateTime
  /// Set when a job is rate-limited and re-queued for the next hour window.
  nextAttemptAt     DateTime?
  sentAt            DateTime?
  attempts          Int         @default(0)
  errorMessage      String?
  providerMessageId String?
  previewUrl        String?
  /// BullMQ job id. Kept in sync with the original scheduled job.
  bullJobId         String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, recipientEmail])
  @@index([status, scheduledFor])
  @@index([campaignId, status])
  @@index([scheduledFor])
}

model SlackConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  teamId      String?
  teamName    String?
  accessToken String?
  webhookUrl  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
